#!/bin/sh
set -eu
if ! command -v python3 >/dev/null 2>&1; then
  echo "Defense Factory needs a Python 3.10+ interpreter for the bundled installer." >&2
  echo "Install Python 3.10+ through your package manager, then rerun this installer." >&2
  exit 2
fi
script_dir=$(dirname "$0")
exec python3 "$script_dir/../skills/defensefactory/scripts/install-defensefactory.py" "$@"
