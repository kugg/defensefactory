{
  "schema_version": 2,
  "component": "<stable-component-id>",
  "bug_classes": [{"id": "<class-id>", "definition": "<recurring failure mechanism>"}],
  "claims": [{
    "id": "<claim-id>",
    "statement": "<canonical property>",
    "preserves": ["<legitimate behavior>"],
    "bug_classes": ["<class-id>"],
    "fences": ["<fence-id>"]
  }],
  "fences": [{
    "id": "<fence-id>", "kind": "hard", "mechanism": "test", "check": "<trusted-check-id>",
    "controls": [{
      "path": "<component-relative-control-path>", "selector": "<test-or-rule-name>",
      "introduced": {"repository": "<original-repository>", "ref": "<full-introduction-commit>", "path": "<original-repo-relative-path>"}
    }]
  }]
}
